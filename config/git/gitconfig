; vim: set ft=gitconfig:
[user]
	name = PunkDevRobot
	email = punkdevninja@proton.me
[pull]
  rebase = true
[init]
	defaultBranch = main
[rebase]
  autoStash = true
[core]
	excludesfile = ~/.gitignore
  pager = delta
[interactive]
  diffFilter = delta --color-only
[blame]
	date = short
[fetch]
	prune = true
[credential "https://github.com"]
	helper = 
	helper = !{{gh_binary}} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{gh_binary}} auth git-credential
[diff]
  tool = difftastic
  external = difft
[difftool]
  prompt = false
[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"
[include]
  path = {{delta_theme_path}}
[delta]
  features = catppuccin-macchiato
  side-by-side = false
  navigate = true    # use n and N to move between diff sections
[merge]
  conflictStyle = zdiff3
[pager]
  difftool = true
[checkout]
	workers = 8
[url "git@github-swap:swapcommerce/"]
	insteadOf = git@github.com:swapcommerce/
