{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Raycast: restore Cmd shortcuts when overlay opens over terminal (Hammerspoon sets variable)",
                        "manipulators": [
                            {
                                "conditions": [{ "name": "raycast_over_terminal", "type": "variable_if", "value": 1 }],
                                "from": { "key_code": "k", "modifiers": { "mandatory": ["left_control"] } },
                                "to": [{ "key_code": "k", "modifiers": ["left_command"] }],
                                "type": "basic"
                            },
                            {
                                "conditions": [{ "name": "raycast_over_terminal", "type": "variable_if", "value": 1 }],
                                "from": { "key_code": "comma", "modifiers": { "mandatory": ["left_control"] } },
                                "to": [{ "key_code": "comma", "modifiers": ["left_command"] }],
                                "type": "basic"
                            },
                            {
                                "conditions": [{ "name": "raycast_over_terminal", "type": "variable_if", "value": 1 }],
                                "from": { "key_code": "return_or_enter", "modifiers": { "mandatory": ["left_control"] } },
                                "to": [{ "key_code": "return_or_enter", "modifiers": ["left_command"] }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Swap Ctrl↔Cmd in all apps except terminals (for Linux muscle memory)",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.mitchellh\\.ghostty$",
                                            "^com\\.apple\\.Terminal$",
                                            "^net\\.kovidgoyal\\.kitty$",
                                            "^io\\.alacritty$",
                                            "^com\\.raphaelamorim\\.rio$"
                                        ],
                                        "type": "frontmost_application_unless"
                                    }
                                ],
                                "from": {
                                    "key_code": "left_control",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_command" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.mitchellh\\.ghostty$",
                                            "^com\\.apple\\.Terminal$",
                                            "^net\\.kovidgoyal\\.kitty$",
                                            "^io\\.alacritty$",
                                            "^com\\.raphaelamorim\\.rio$"
                                        ],
                                        "type": "frontmost_application_unless"
                                    }
                                ],
                                "from": {
                                    "key_code": "left_command",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_control" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.mitchellh\\.ghostty$",
                                            "^com\\.apple\\.Terminal$",
                                            "^net\\.kovidgoyal\\.kitty$",
                                            "^io\\.alacritty$",
                                            "^com\\.raphaelamorim\\.rio$"
                                        ],
                                        "type": "frontmost_application_unless"
                                    }
                                ],
                                "from": {
                                    "key_code": "right_control",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "right_command" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.mitchellh\\.ghostty$",
                                            "^com\\.apple\\.Terminal$",
                                            "^net\\.kovidgoyal\\.kitty$",
                                            "^io\\.alacritty$",
                                            "^com\\.raphaelamorim\\.rio$"
                                        ],
                                        "type": "frontmost_application_unless"
                                    }
                                ],
                                "from": {
                                    "key_code": "right_command",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "right_control" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": {
                        "device_address": "ce-ca-6f-03-3d-a2",
                        "is_keyboard": true,
                        "is_pointing_device": true
                    },
                    "ignore": false
                }
            ],
            "name": "Default",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}