{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omaplug"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.active-window"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "meviusisback.agent-orchestr"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "io.github.sohanemon.submap"
        }
      ],
      "right": [
        {
          "id": "io.github.tyrichards.tray"
        },
        {
          "id": "io.github.x3me.nexthop"
        },
        {
          "id": "zeru.portwatch"
        },
        {
          "id": "harshith.system-monitor",
          "barMode": "Adaptive"
        },
        {
          "id": "robzolkos.github"
        },
        {
          "id": "jankeesvw.notification-center"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "tmn73.calendar"
        },
        {
          "id": "jkoestinger.vpn"
        },
        {
          "id": "ee-preset",
          "type": "command",
          "exec": "echo \"EQ \u00b7 $(easyeffects -a output)\"",
          "interval": 5,
          "tooltip": "EasyEffects output preset \u00b7 click: ee-toggle",
          "onClick": "ee-toggle"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 1200,
    "screensaver": 600
  },
  "plugins": [
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "boot": "theme",
      "design": "aurora"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "nerdyworm.easyeffects-presets",
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer"
  ]
}
