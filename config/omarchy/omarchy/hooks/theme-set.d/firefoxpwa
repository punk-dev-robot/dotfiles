#!/bin/bash
# FirefoxPWA web apps follow the omarchy theme (see hooks/theme-set.d/zen for the pattern).
# Symlinks the rendered firefoxpwa.css into every profile's chrome dir; never kills the apps.
set -euo pipefail

theme=$HOME/.local/state/omarchy/current/theme
[[ -f $theme/firefoxpwa.css ]] || exit 0

for dir in "$HOME"/.local/share/firefoxpwa/profiles/*/; do
  mkdir -p "$dir/chrome"
  ln -sfn "$theme/firefoxpwa.css" "$dir/chrome/omarchy.css"
  grep -qsF 'omarchy.css' "$dir/chrome/userChrome.css" || printf '@import url("omarchy.css");\n' >>"$dir/chrome/userChrome.css"
done
