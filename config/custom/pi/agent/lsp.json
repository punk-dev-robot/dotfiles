{
  "version": 1,
  "servers": [
    {
      "id": "pyright",
      "include": ["**/*.py", "**/*.pyi"],
      "exclude": ["**/.venv/**", "**/node_modules/**"],
      "rootMarkers": ["pyproject.toml", "setup.py", "requirements.txt", ".git"],
      "bin": "pyright-langserver",
      "args": ["--stdio"],
      "cwd": "{root}",
      "languageIdByExtension": { ".py": "python", ".pyi": "python" },
      "diagnosticsWaitMs": 2000
    },
    {
      "id": "typescript",
      "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs"],
      "exclude": ["**/node_modules/**", "**/dist/**"],
      "rootMarkers": ["tsconfig.json", "package.json", ".git"],
      "bin": "typescript-language-server",
      "args": ["--stdio"],
      "initializationOptions": { "tsserver": { "path": "{{home_dir}}/.local/share/mise/installs/npm-typescript/5/node_modules/typescript/lib" } },
      "cwd": "{root}",
      "languageIdByExtension": { ".ts": "typescript", ".tsx": "typescriptreact", ".js": "javascript", ".jsx": "javascriptreact", ".mjs": "javascript" },
      "diagnosticsWaitMs": 2000
    }
  ]
}
