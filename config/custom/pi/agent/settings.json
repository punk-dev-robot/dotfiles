    "npm:pi-readseek",
    "npm:@ff-labs/pi-fff",
    {
      "source": "npm:@dietrichgebert/ponytail",
      "skills": [
        "-skills/ponytail-audit/SKILL.md",
        "-skills/ponytail-debt/SKILL.md",
        "-skills/ponytail-gain/SKILL.md",
        "-skills/ponytail-help/SKILL.md"
      ]
    },
    "npm:pi-caveman",
    "npm:pi-mcp-adapter@2.32.1",
    "npm:pi-advisor-flow",
    "npm:pi-cymbal",
    "npm:@ogulcancelik/pi-herdr",
    "npm:@yassimba/pi-herdr-worktree",
    "npm:pi-web-access",
    {
      "source": "npm:context-mode",
      "skills": [
        "+skills/context-mode/SKILL.md"
      ]
    },
    "npm:@plannotator/pi-extension",
    "npm:pi-mermaid",
    "npm:@tmustier/pi-usage-extension",
    "npm:@zhcsyncer/pi-recap",
    "npm:@firstpick/pi-extension-tools",
    "git:github.com/punk-dev-robot/pi-otel@feat/thinking-dropped-attr",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@pi-kaush/pi-btw-with-imports",
    "npm:pi-cc-header",
    "npm:pi-skills-manager",
    "npm:@d3ara1n/pi-context-include",
    "npm:@tigorhutasuhut/pi-rules",
    "../../../dev/oss/pi-extensible-workflows/packages/core",
    "../../../dev/oss/pi-extensible-workflows/packages/extensions/herdr",
    "npm:@henryqw/pi-task-models",
    "npm:@henryqw/pi-herdr-rename"
  ],
  "npmCommand": [
    "fnm",
    "exec",
    "--using",
    "26.5.0",
    "npm"
  ],
  "lastChangelogVersion": "0.85.1",
  "showCacheMissNotices": false,
  "defaultProvider": "anthropic",
  "defaultModel": "claude-fable-5-1",
  "defaultThinkingLevel": "high",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 64000,
    "keepRecentTokens": 40000
  },
  "observational-memory": {
    "observeAfterTokens": 10000,
    "reflectAfterTokens": 20000,
    "compactAfterTokens": 81000,
    "compactAfterTokensMode": "ratio",
    "compactAfterTokensRatio": 0.18,
    "observationsPoolMaxTokens": 20000,
    "observationsPoolTargetTokens": 10000,
    "agentMaxTurns": 16,
    "model": {
      "provider": "anthropic",
      "id": "claude-sonnet-5",
      "thinking": "low"
    },
    "showWorkerNotifications": false,
    "passive": false,
    "debugLog": false
  },
  "hideThinkingBlock": false,
  "quietStartup": false,
  "collapseChangelog": true,
  "clearOnStart": true,
  "theme": "terminal",
  "ccHeader": {
    "pkg": true,
    "readOnlyConfig": true
  },
  "otel": {
    "enabled": true,
    "endpoint": "https://logfire-eu.pydantic.dev",
    "protocol": "http/protobuf",
    "serviceName": "pi",
    "captureContent": "full",
    "spanNaming": "genai",
    "sampleRatio": 1,
    "signals": {
      "traces": true,
      "metrics": true,
      "logs": true
    }
  },
  "readseek": {
    "overrideTools": [
      "read",
      "edit",
      "write"
    ]
  },
  "skills": [
    "-../../.agents/skills/plannotator-compound/SKILL.md",
    "-../../.agents/skills/plannotator-setup-goal/SKILL.md",
    "+../../.agents/skills/tessl__wayfinder/SKILL.md",
    "+../../.agents/skills/logfire-instrumentation/SKILL.md",
    "-../../.agents/skills/tessl__html-prototype/SKILL.md",
    "-../../.agents/skills/tessl__html-wireframe/SKILL.md",
    "-../../.agents/skills/tessl__linear-cli/SKILL.md",
    "-../../.agents/skills/tessl__notion/SKILL.md",
    "-../../.agents/skills/tessl__setup-matt-pocock-skills/SKILL.md",
    "-../../.agents/skills/tessl__writing-for-agents/SKILL.md",
    "-../../.agents/skills/tessl__wizard/SKILL.md"
  ]
}