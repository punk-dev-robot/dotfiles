{
  "packages": [
    "npm:@dietrichgebert/ponytail",
    "npm:@ogulcancelik/pi-herdr",
    "npm:@pi-kaush/pi-double-paste@0.1.0",
    "npm:@pi-kaush/pi-tool-call-markers",
    "npm:@plannotator/pi-extension",
    "npm:@spences10/pi-observability",
    "npm:@spences10/pi-telemetry",
    "npm:@tifan/pi-rename",
    "npm:@tmustier/pi-usage-extension",
    "npm:@xynogen/pix-data",
    "npm:@xynogen/pix-models",
    "npm:@xynogen/pix-nudge",
    "npm:@yassimba/pi-herdr-worktree",
    "npm:@zhcsyncer/pi-recap",
    "npm:context-mode",
    "npm:pi-advisor-flow",
    "npm:pi-ask-herdr",
    "npm:pi-atuin",
    "npm:pi-caveman",
    "npm:pi-claude-auth",
    "npm:pi-claude-code-ui",
    "npm:pi-fancy-footer",
    "npm:pi-herdr-subagents",
    "npm:pi-image-tools",
    "npm:pi-lens",
    "npm:pi-markdown-preview",
    "npm:pi-mcp-adapter",
    "npm:pi-mermaid",
    "npm:pi-observational-memory",
    "npm:pi-perf",
    "npm:pi-rename-pane",
    "npm:pi-rtk-optimizer",
    "npm:pi-skill-gate",
    "npm:pi-terminal-theme",
    "npm:pi-vim",
    "npm:pi-web-access",
    "npm:pine-of-glass",
    "npm:@quintinshaw/pi-dynamic-workflows",
    "npm:pi-cc-header",
    "npm:pi-oc-style-agent-switcher"
  ],
  "lastChangelogVersion": "0.82.1",
  "showCacheMissNotices": true,
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "anthropic/claude-fable-5",
    "anthropic/claude-sonnet-5",
    "anthropic/claude-opus-5"
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 100000,
    "keepRecentTokens": 20000
  },
  "observational-memory": {
    "observeAfterTokens": 10000,
    "reflectAfterTokens": 20000,
    "compactAfterTokens": 81000,
    "compactAfterTokensMode": "ratio",
    "compactAfterTokensRatio": 0.5,
    "observationsPoolMaxTokens": 20000,
    "observationsPoolTargetTokens": 10000,
    "agentMaxTurns": 16,
    "model": {
      "provider": "anthropic",
      "id": "claude-sonnet-5",
      "thinking": "low"
    },
    "showWorkerNotifications": false,
    "passive": false,
    "debugLog": false
  },
  "powerline": {
    "preset": "default",
    "placement": "below",
    "layout": {
      "left": [
        "model",
        "thinking",
        "path",
        "git",
        "context_pct"
      ],
      "right": [],
      "secondary": [
        "extension_statuses",
        "custom:lens",
        "custom:mcp",
        "custom:ponytail",
        "custom:caveman"
      ]
    },
    "customItems": [
      {
        "id": "lens",
        "statusKey": "pi-lens-lsp",
        "position": "secondary"
      },
      {
        "id": "mcp",
        "statusKey": "mcp",
        "position": "secondary"
      },
      {
        "id": "ponytail",
        "statusKey": "ponytail",
        "position": "secondary"
      },
      {
        "id": "caveman",
        "statusKey": "caveman",
        "position": "secondary"
      }
    ],
    "disabledSegments": [
      "cache_read",
      "shell_mode",
      "cost"
    ],
    "path": {
      "mode": "basename"
    },
    "model": {
      "display": "name"
    }
  },
  "hideThinkingBlock": true,
  "quietStartup": false,
  "collapseChangelog": true,
  "clearOnStart": false,
  "theme": "terminal",
  "rsl": false,
  "ccHeader": {
    "pkg": true
  }
}
