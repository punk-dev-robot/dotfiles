{
  "packages": [
    "npm:context-mode",
    "npm:@plannotator/pi-extension",
    "npm:pi-mcp-adapter",
    "npm:pine-of-glass",
    "npm:pi-observational-memory",
    "npm:pi-claude-auth",
    "npm:pi-web-access",
    "npm:pi-simplify",
    "npm:@spences10/pi-telemetry",
    "npm:@spences10/pi-observability",
    "npm:@minhduydev/pi-subagents",
    "npm:pi-advisor-flow",
    "npm:@ogulcancelik/pi-herdr",
    "npm:pi-rename-pane",
    "npm:@tmustier/pi-usage-extension",
    "npm:pi-herdr-btw",
    "npm:@zhcsyncer/pi-recap",
    "npm:@yassimba/pi-herdr-worktree",
    "npm:@tifan/pi-rename",
    "npm:pi-mermaid",
    "npm:pi-markdown-preview",
    "npm:pi-ask-herdr",
    "npm:@xynogen/pix-data",
    "npm:@xynogen/pix-models",
    "npm:@xynogen/pix-update",
    "npm:@xynogen/pix-nudge",
    "npm:pi-tool-display",
    "npm:pi-caveman",
    "npm:pi-rtk-optimizer",
    "npm:pi-ponytail",
    "npm:pi-powerline-footer",
    "npm:pi-claude-code-tui",
    "npm:pi-lens",
    "npm:pi-image-tools",
    "npm:pi-copy-message",
    "npm:pi-cc-header",
    "npm:pi-atuin"
  ],
  "powerline": {
    "preset": "default",
    "fixedEditor": true,
    "disabledSegments": [
      "cost",
      "token_total",
      "context_total",
      "cache_read",
      "cache_write"
    ],
    "placement": "above"
  },
  "lastChangelogVersion": "0.82.0",
  "theme": "catppuccin-black-mocha",
  "showCacheMissNotices": true,
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-4-8",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "anthropic/claude-fable-5",
    "anthropic/claude-sonnet-5",
    "anthropic/claude-opus-5"
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "hideThinkingBlock": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 100000,
    "keepRecentTokens": 20000
  },
  "observational-memory": {
    "observeAfterTokens": 10000,
    "reflectAfterTokens": 20000,
    "compactAfterTokens": 81000,
    "compactAfterTokensMode": "ratio",
    "compactAfterTokensRatio": 0.5,
    "observationsPoolMaxTokens": 20000,
    "observationsPoolTargetTokens": 10000,
    "agentMaxTurns": 16,
    "model": {
      "provider": "anthropic",
      "id": "claude-sonnet-5",
      "thinking": "low"
    },
    "showWorkerNotifications": false,
    "passive": false,
    "debugLog": false
  },
  "quietStartup": true,
  "clearOnStart": true
}