    "npm:pi-caveman",
    "npm:pi-mcp-adapter",
    "npm:pi-advisor-flow",
    "npm:pi-cymbal",
    "npm:@ogulcancelik/pi-herdr",
    "npm:@yassimba/pi-herdr-worktree",
    "git:github.com/edxeth/pi-subagents",
    "/Users/kuba.gaj/.config/pi/agent/git/github.com/edxeth/pi-subagents",
    "npm:pi-web-access",
    "npm:context-mode",
    "npm:@plannotator/pi-extension",
    "npm:pi-mermaid",
    "npm:@tmustier/pi-usage-extension",
    "npm:@zhcsyncer/pi-recap",
    "npm:@tifan/pi-rename",
    "npm:pi-rename-pane",
    "npm:@firstpick/pi-extension-tools",
    "git:github.com/punk-dev-robot/pi-otel@fix/otlp-http-per-signal-paths",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-extensible-workflows",
    "npm:@piewf/herdr",
    "npm:pi-agent-browser-native",
    "npm:@pi-kaush/pi-btw-with-imports",
    "npm:pi-cc-header",
    "npm:pi-skills-manager",
    "npm:@d3ara1n/pi-context-include",
    "npm:@tigorhutasuhut/pi-rules",
    "npm:@piewf/subagents"
  ],
  "npmCommand": ["fnm", "exec", "--using", "26.5.0", "npm"],
  "lastChangelogVersion": "0.84.1",
  "showCacheMissNotices": false,
  "defaultProvider": "anthropic",
  "defaultModel": "claude-fable-5",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "anthropic/claude-fable-5",
    "anthropic/claude-sonnet-5",
    "anthropic/claude-opus-5"
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 100000,
    "keepRecentTokens": 20000
  },
  "observational-memory": {
    "observeAfterTokens": 10000,
    "reflectAfterTokens": 20000,
    "compactAfterTokens": 81000,
    "compactAfterTokensMode": "ratio",
    "compactAfterTokensRatio": 0.63,
    "observationsPoolMaxTokens": 20000,
    "observationsPoolTargetTokens": 10000,
    "agentMaxTurns": 16,
    "model": {
      "provider": "anthropic",
      "id": "claude-sonnet-5",
      "thinking": "low"
    },
    "showWorkerNotifications": false,
    "passive": false,
    "debugLog": false
  },
  "hideThinkingBlock": true,
  "quietStartup": false,
  "collapseChangelog": true,
  "clearOnStart": true,
  "theme": "terminal",
  "ccHeader": {
    "pkg": true
  },
  "otel": {
    "enabled": true,
    "endpoint": "https://logfire-eu.pydantic.dev",
    "protocol": "http/protobuf",
    "serviceName": "pi",
    "captureContent": "full",
    "spanNaming": "genai",
    "sampleRatio": 1,
    "signals": {
      "traces": true,
      "metrics": true,
      "logs": true
    }
  },
  "skills": [
    "-../../.agents/skills/plannotator-compound/SKILL.md",
    "-../../.agents/skills/plannotator-setup-goal/SKILL.md",
    "+../../.agents/skills/tessl__wayfinder/SKILL.md"
  ]
}
