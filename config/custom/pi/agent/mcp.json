{
  "settings": {
    "toolPrefix": "server",
    "hostConfigDiscovery": "off",
    "outputGuard": true
  },
  "mcpServers": {
    "incidentio": {
      "url": "https://mcp.incident.io/mcp",
      "lifestyle": "lazy"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "auth": "bearer",
      "bearerToken": "!gh auth token",
      "lifecycle": "lazy"
    },
    "logfire": {
      "url": "http://localhost:3000/logfire",
      "lifecycle": "lazy"
    },
    "logfire-swap": {
      "url": "http://localhost:3000/logfire-swap",
      "lifecycle": "lazy"
    },
    "notion": {
      "url": "http://localhost:3000/notion",
      "lifecycle": "lazy"
    },
    "gateway": {
      "url": "http://localhost:3000/mcp",
      "lifecycle": "lazy",
      "description": "agentgateway: exa, firecrawl, linear, context7 (tools prefixed by upstream name)"
    },
    "gmail": {
      "url": "https://gmailmcp.googleapis.com/mcp/v1",
      "lifecycle": "lazy"
    },
    "calendar": {
      "url": "https://calendarmcp.googleapis.com/mcp/v1",
      "lifecycle": "lazy"
    },
    "newrelic": {
      "url": "http://localhost:3000/newrelic",
      "lifecycle": "lazy"
    },
    "slack": {
      "url": "http://localhost:3000/slack",
      "lifecycle": "lazy"
    },
    "repowise": {
      "command": "repowise",
      "lifecycle": "lazy-keep-alive",
      "args": ["mcp", ".", "--transport", "stdio", "--all"],
      "directTools": [
        "search_codebase",
        "get_answer",
        "get_context",
        "get_symbol",
        "get_why",
        "get_risk"
      ],
      "description": "repowise: codebase intelligence — docs, graph, git signals, dead code, decisions"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "lifecycle": "lazy"
    },
    "executor": {
      "url": "http://localhost:4789/mcp",
      "lifecycle": "lazy",
      "auth": "bearer",
      "bearerTokenStore": true
    }
  }
}
