{
  "settings": {
    "toolPrefix": "server",
    "hostConfigDiscovery": "off",
    "outputGuard": true
  },
  "mcpServers": {
    "logfire": {
      "url": "https://logfire-eu.pydantic.dev/mcp",
      "lifecycle": "lazy"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "lifecycle": "lazy"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "lifecycle": "lazy"
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "lifecycle": "lazy"
    },
    "firecrawl": {
      "url": "https://mcp.firecrawl.dev/v2/mcp-oauth",
      "lifecycle": "lazy"
    },
    "gmail": {
      "url": "https://gmailmcp.googleapis.com/mcp/v1",
      "lifecycle": "lazy"
    },
    "calendar": {
      "url": "https://calendarmcp.googleapis.com/mcp/v1",
      "lifecycle": "lazy"
    },
    "newrelic": {
      "url": "https://mcp.eu.newrelic.com/mcp/",
      "lifecycle": "lazy"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp/oauth",
      "lifecycle": "lazy"
    },
    "slack": {
      "url": "https://mcp.slack.com/mcp",
      "lifecycle": "lazy",
      "auth": "oauth",
      "oauth": {
        "clientId": "2966739332885.11949201186418",
        "clientSecret": "!op read 'op://AI/Swap-Slack-MCP-Client-Secret/password' --account my.1password.com",
        "redirectUri": "http://localhost:3118/callback",
        "scope": "canvases:read canvases:write channels:history channels:read chat:write groups:history search:read.private search:read.public users:read",
        "authorizationParams": {
          "user_scope": "canvases:read,canvases:write,channels:history,channels:read,chat:write,groups:history,search:read.private,search:read.public,users:read"
        }
      }
    },
    "repowise": {
      "command": "repowise",
      "lifecycle": "lazy-keep-alive",
      "args": [
        "mcp",
        ".",
        "--transport",
        "stdio",
        "--tools",
        "lean"
      ],
      "description": "repowise: codebase intelligence — docs, graph, git signals, dead code, decisions"
    }
  }
}
