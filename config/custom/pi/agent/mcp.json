{
  "settings": {
    "toolPrefix": "server",
    "hostConfigDiscovery": "off",
    "outputGuard": true
  },
  "mcpServers": {
    "logfire": {
      "url": "http://localhost:3000/logfire",
      "lifecycle": "lazy"
    },
    "notion": {
      "url": "http://localhost:3000/notion",
      "lifecycle": "lazy"
    },
    "gateway": {
      "url": "http://localhost:3000/mcp",
      "lifecycle": "lazy",
      "description": "agentgateway: exa, firecrawl, linear, context7 (tools prefixed by upstream name)"
    },
    "gmail": {
      "url": "https://gmailmcp.googleapis.com/mcp/v1",
      "lifecycle": "lazy"
    },
    "calendar": {
      "url": "https://calendarmcp.googleapis.com/mcp/v1",
      "lifecycle": "lazy"
    },
    "newrelic": {
      "url": "http://localhost:3000/newrelic",
      "lifecycle": "lazy"
    },
    "slack": {
      "url": "http://localhost:3000/slack",
      "lifecycle": "lazy"
    },
    "repowise": {
      "command": "repowise",
      "lifecycle": "lazy-keep-alive",
      "args": [
        "mcp",
        ".",
        "--transport",
        "stdio",
        "--tools",
        "lean"
      ],
      "description": "repowise: codebase intelligence — docs, graph, git signals, dead code, decisions"
    }
  }
}
