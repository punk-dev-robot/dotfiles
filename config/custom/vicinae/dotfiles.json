// Shared vicinae config (dotter template, linux + mac). Imported by ~/.config/vicinae/settings.json
// via "imports": settings.json is GUI-written and holds secrets/local paths, so it stays untracked
// and overrides anything here. Extension provider ids: see extensions.txt.
{
  "$schema": "https://vicinae.com/schemas/config.json",
{{#if is_omarchy}}
  // Theme generated by omarchy hook: config/omarchy/omarchy/hooks/theme-set.d/vicinae
  "theme": { "light": { "name": "omarchy" }, "dark": { "name": "omarchy" } },
{{/if}}
  "providers": {
    "@khasbilegt/store.raycast.1password": {
      "preferences": {
        "closeWindowAfterCopying": true,
        "primaryAction": "open-in-1password",
        "secondaryAction": "open-in-browser",
        "reduceItemListMemoryUsage": true,
        "version": "v8",
        "zshPath": "/bin/zsh",
        "cliPath": "{{#if is_macos}}/opt/homebrew/bin/op{{else}}/usr/bin/op{{/if}}"
      }
    },
    "@knoopx/store.vicinae.github": {
      "preferences": { "defaultIssueFilter": "my", "defaultRepositoryFilter": "my", "numberOfResults": "50" }
    },
    "@lightbody/store.raycast.reclaim-ai": {
      // apiToken lives in settings.json (secret)
      "preferences": { "apiUrl": "https://api.app.reclaim.ai/api", "upcomingEventsCount": "5" }
    },
    "@maggie/store.raycast.todo-list": {
      "preferences": {
        "completed": "hide_all",
        "groupByPriority": "group_todo_completed",
        "nlpParsing": true,
        "sortOrder": "creation_date_ascending",
        "useConfetti": false
      }
    },
    "@mattisssa/store.raycast.spotify-player": {
      "entrypoints": { "dislike": { "enabled": true }, "like": { "enabled": true }, "startDJ": { "enabled": true } }
    },
    "@mommertf/store.raycast.slack": {
      "preferences": { "closeRightSidebar": true, "showAiMessageSignature": true }
    },
    "@thomaslombart/store.raycast.linear": {
      "preferences": { "labelsLimit": "100", "limit": "50", "shouldHideRedundantIssues": false }
    }
  }
}
