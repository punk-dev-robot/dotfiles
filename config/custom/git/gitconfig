; vim: set ft=gitconfig:
[user]
	name = PunkDevRobot
	email = punkdevninja@proton.me
[pull]
  rebase = true
[init]
	defaultBranch = main
[rebase]
  autoStash = true
[core]
	excludesfile = ~/.gitignore
	# shared repowise index auto-update hooks; shadows per-repo .git/hooks (only
	# repowise's own post-commit lived there, and config/custom/git/hooks replaces it)
	hooksPath = ~/.config/git/hooks
  pager = delta
[interactive]
  diffFilter = delta --color-only
[blame]
	date = short
[fetch]
	prune = true
[credential "https://github.com"]
	helper = 
	helper = !{{gh_binary}} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{gh_binary}} auth git-credential
[diff]
  tool = difftastic
  external = difft
[difftool]
  prompt = false
[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"
[include]
  path = {{delta_theme_path}}
[include]
  # machine-local state (git maintenance register etc.); missing file is ignored
  path = ~/.gitconfig-maintenance
[delta]
  features = catppuccin-macchiato
  side-by-side = false
  navigate = true    # use n and N to move between diff sections
[merge]
  conflictStyle = zdiff3
[pager]
  difftool = true
[checkout]
	workers = 8
# adopted from omarchy's skel git config (KUB-97); aliases + defaultBranch=master skipped
[column]
  ui = auto                # Output in columns when possible
[branch]
  sort = -committerdate    # Sort branches by most recent commit first
[tag]
  sort = -version:refname  # Sort version numbers as you would expect
[rerere]
  enabled = true           # Record and reuse conflict resolutions
  autoupdate = true        # Apply stored conflict resolutions automatically
[url "git@github-swap:swapcommerce/"]
	insteadOf = git@github.com:swapcommerce/
[includeIf "gitdir:/Users/kuba.gaj/dev/swapc/"]
	path = ~/dotfiles/config/custom/git/gitconfig-swap
