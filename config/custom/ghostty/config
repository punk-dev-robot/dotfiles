# Font
font-family = MesloLGL Nerd Font Mono
font-size = 18
adjust-icon-height=10%

# Theme
theme = Catppuccin Mocha

# Palette slots 16-23: pi's `terminal-tinted` theme (pi-terminal-theme) reads these
# as UI colors - selected/message/tool backgrounds and tool title/output text.
# Values are Catppuccin Mocha surfaces plus hue tints over base #1e1e2e.
# Trade-off: any app addressing xterm-cube indices 16-23 directly gets these
# instead of the stock cube (16=black, 17-21 dark blues, 22-23 dark greens).
palette = 16=#585b70
palette = 17=#45293a
palette = 18=#26402f
palette = 19=#453b26
palette = 20=#313244
palette = 21=#3b2f4d
palette = 22=#89b4fa
palette = 23=#a6adc8

# Window
background-opacity = 0.90
# window-decoration = false

# Terminal
clipboard-read = allow
clipboard-write = allow

{{#if is_macos}}
# Auto-attach to tmux main session (escape hatch: ghostty -e /bin/zsh)
# command = /opt/homebrew/bin/tmux new-session -A -s main

# Quick terminal (drop-down, Quake-style)
# position change requires Ghostty restart; global keybind needs Accessibility permission
quick-terminal-position = top
quick-terminal-size = 55%,50%
quick-terminal-animation-duration = 0.15
# Karabiner swaps Ctrl↔Cmd in non-terminal apps, so physical Ctrl+`
# arrives as Cmd+` when another app is focused, and stays Ctrl+`
# when Ghostty itself is focused (no swap). Bind both to cover both cases.
keybind = global:cmd+grave_accent=toggle_quick_terminal
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Copy/paste like Linux terminal (Ctrl+Shift+C/V)
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Unbind window/tab/split management (using tmux instead)
# Window
keybind = cmd+n=ignore
keybind = cmd+shift+w=ignore
keybind = cmd+shift+alt+w=ignore
# cmd+enter is bound to toggle_quick_terminal above
# Tabs
keybind = cmd+t=ignore
keybind = cmd+w=ignore
keybind = cmd+shift+left_bracket=ignore
keybind = cmd+shift+right_bracket=ignore
keybind = cmd+one=ignore
keybind = cmd+two=ignore
keybind = cmd+three=ignore
keybind = cmd+four=ignore
keybind = cmd+five=ignore
keybind = cmd+six=ignore
keybind = cmd+seven=ignore
keybind = cmd+eight=ignore
keybind = cmd+nine=ignore
# Splits
keybind = cmd+d=ignore
keybind = cmd+shift+d=ignore
keybind = cmd+left_bracket=ignore
keybind = cmd+right_bracket=ignore
keybind = cmd+alt+up=ignore
keybind = cmd+alt+down=ignore
keybind = cmd+alt+left=ignore
keybind = cmd+alt+right=ignore
keybind = cmd+shift+enter=ignore
keybind = cmd+ctrl+up=ignore
keybind = cmd+ctrl+down=ignore
keybind = cmd+ctrl+left=ignore
keybind = cmd+ctrl+right=ignore
keybind = cmd+ctrl+equal=ignore
# Other
keybind = cmd+k=ignore
{{/if}}
