# Host-specific blocks must come before Host * (first match wins in SSH config)

Host github-swap
  HostName github.com
  User git
  IdentityFile ~/.ssh/kuba.swap.pub
  IdentitiesOnly yes
  ControlMaster no
  ControlPath none

# Enable reusing connections
ControlMaster auto
ControlPath ~/.ssh/control-%C
ControlPersist yes

Host *
  # Safer default: trust new hosts, and update keys automatically
  StrictHostKeyChecking accept-new
  UpdateHostKeys yes
  HashKnownHosts yes
  TCPKeepAlive yes
  ServerAliveInterval 60
  ServerAliveCountMax 240
  IdentityAgent "{{op_agent_sock}}"
#  RemoteForward 52698 127.0.0.1:52698
#  ForwardAgent yes
