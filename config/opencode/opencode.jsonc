{
  "mcp": {
    "logfire": {
      "enabled": false,
      "type": "remote",
      "url": "https://logfire-eu.pydantic.dev/mcp",
    },
    "tessl": {
      "enabled": true,
      "type": "local",
      "command": ["tessl", "mcp", "start"],
    },
    "ChunkHound": {
      "type": "local",
      "command": ["chunkhound", "mcp"],
    },
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "serena",
        "start-mcp-server",
        "--context=oaicompat-agent",
        "--project-from-cwd",
        "--open-web-dashboard=False",
      ],
    },
    "composio": {
      "enabled": true,
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
    },
  },
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "plugin": [
    "@plannotator/opencode@latest",
    "./plugins/modern-cli-warn.ts",
    "./plugins/prefer-composio-web.ts",
    "./plugins/linear-agent-workflow.ts",
  ],
  "skills": {
    "paths": ["/Users/kuba.gaj/.config/opencode/skills"],
  },
  "permission": {
    "bash": {
      "nx run deploy:*": "deny",
      "nx deploy:*": "deny",
    },
  },
}
