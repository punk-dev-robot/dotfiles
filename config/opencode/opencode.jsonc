{
  "mcp": {
    "tessl": {
      "type": "local",
      "command": ["tessl", "mcp", "start"],
    },
    "basic-memory": {
      "enabled": false,
      "type": "local",
      "command": ["uvx", "basic-memory", "mcp"],
      "environment": {
        "LOG_LEVEL": "warn",
      },
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
    },
    "exa": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "exa-mcp-server",
        "--tools=web_search_exa,research_paper_search,company_research,crawling,competitor_finder,linkedin_search,wikipedia_search_exa,github_search",
      ],
    },
    "firecrawl": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "environment": {
        "FIRECRAWL_API_URL": "http://10.10.10.51:3002",
      },
    },
    "firecrawl-cloud": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
    },
    "serena": {
      "type": "local",
      "enabled": false,
      "command": [
        "serena",
        "start-mcp-server",
        "--context=oaicompat-agent",
        "--project-from-cwd",
      ],
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/sse",
    },
  },
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "instructions": ["./instructions.md"],
  "plugin": [
    "@plannotator/opencode@latest",
    "./plugins/modern-cli-warn.ts",
    "./plugins/spec-kit-plannotator.ts",
  ],
  "permission": {
    "bash": {
      "nx run deploy:*": "deny",
      "nx deploy:*": "deny",
    },
  },
}
