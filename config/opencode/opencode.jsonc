{
  "mcp": {
    "logfire": {
      "enabled": false,
      "type": "remote",
      "url": "https://logfire-eu.pydantic.dev/mcp",
    },
    "tessl": {
      "enabled": true,
      "type": "local",
      "command": ["tessl", "mcp", "start"],
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/kuba.gaj/dotfiles",
        "/Users/kuba.gaj/dev",
        "/Users/kuba.gaj/Documents/notes",
      ],
    },
  },
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "plugin": [
    "@plannotator/opencode@latest",
    "./plugins/modern-cli-warn.ts",
    "./plugins/prefer-composio-web.ts",
    "./plugins/linear-agent-workflow.ts",
    "./plugins/cupcake.js",
  ],
  "skills": {
    "paths": ["/Users/kuba.gaj/.config/opencode/skills"],
  },
  "permission": {
    "bash": {
      "nx run deploy:*": "deny",
      "nx deploy:*": "deny",
    },
  },
}
