{
  "cleanupPeriodDays": 31,
  "skillListingBudgetFraction": 0.02,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "0",
    "CLAUDE_CODE_ALT_SCREEN_FULL_REPAINT": "1",
    "CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL": "0",
    "CLAUDE_CODE_FORCE_SYNC_OUTPUT": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "3",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "0",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "ENABLE_TOOL_SEARCH": "false",
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "MCP_TIMEOUT": "60000",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "0",
    "DISABLE_TELEMETRY": "1",
    "OTEL_TRACES_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://ingest.eu2.signoz.cloud:443",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000",
    "OTEL_LOGS_EXPORT_INTERVAL": "5000",
    "OTEL_SERVICE_NAME": "claude-code",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_TOOL_CONTENT": "1"
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Read",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(pwd)",
      "Bash(date *)",
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm list *)",
      "Bash(npx *)",
      "Bash(systemctl status *)",
      "Bash(systemctl is-active *)",
      "Bash(journalctl *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(eza *)",
      "Bash(bat *)",
      "Bash(dust *)",
      "Bash(duf *)",
      "Bash(procs *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(tokei *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(tee *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(uv *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "ToolSearch",
      "mcp__*",
      "Bash(curl -sS -X POST https://firestore.googleapis.com/v1/projects/swap-cloud-uat/databases/*)",
      "Bash(curl -sS https://firestore.googleapis.com/v1/projects/swap-cloud-uat/databases/*)",
      "Bash(gcloud firestore databases list --project swap-cloud-uat:*)",
      "Bash(gcloud auth print-access-token:*)"
    ],
    "deny": [
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(npm -g install *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(yarn global *)",
      "Bash(sudo pacman *)",
      "Bash(pacman -S *)",
      "Bash(pacman -R *)",
      "Bash(pacman -U *)",
      "Bash(sudo rm *)",
      "Bash(reboot *)",
      "Bash(shutdown *)",
      "Bash(poweroff *)",
      "Bash(grep *)",
      "Bash(grep)",
      "Bash(egrep *)",
      "Bash(fgrep *)",
      "Bash(find *)",
      "Bash(find)",
      "Bash(sed *)",
      "Bash(sed)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": ["~/dotfiles", "~/Pictures/Screenshots"],
    "skipDengerousModePermissionPrompt": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cupcake eval --harness claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook claude-code pretooluse"
          },
          {
            "type": "command",
            "command": "~/.config/claude/hooks/bash-ban-raw-tools.sh"
          },
          {
            "type": "command",
            "command": "~/.config/claude/hooks/modern-cli.py"
          },
          {
            "type": "command",
            "command": "~/.config/claude/hooks/block-danger.py"
          },
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/prefer-tools.py"
          }
        ]
      },
      {
        "matcher": "DISABLED_Edit|Write_DISABLED",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/spec-kit-plannotator.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cupcake eval --harness claude"
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Read|Search",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/cbm-code-discovery-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook claude-code posttooluse"
          },
          {
            "type": "command",
            "command": "~/.config/claude/hooks/cbm-mcp-marker.sh"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cupcake eval --harness claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cupcake eval --harness claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/task-observer-start.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/cbm-session-reminder.sh"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/cbm-session-reminder.sh"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/cbm-session-reminder.sh"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/cbm-session-reminder.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/context-mode-cache-heal.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/task-observer-stop.sh",
            "timeout": 2
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/notify.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/linear-agent-workflow.sh",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "context-mode hook claude-code precompact"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccline"
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "plannotator@plannotator": true,
    "agent-skills@addy-agent-skills": false,
    "skill-codex@skill-codex": true,
    "superpowers@claude-plugins-official": false,
    "punkfl0w@punkfl0w-development": false,
    "caveman@caveman": true,
    "skill-creator@claude-plugins-official": false,
    "logfire-session-capture@pydantic-claude-code-logfire-plugin": false,
    "clangd-lsp@claude-plugins-official": false,
    "plugin-setup@shopware-ai-coding-tools": false,
    "context-mode@context-mode": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      },
      "autoUpdate": true
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "skill-codex": {
      "source": {
        "source": "github",
        "repo": "skills-directory/skill-codex"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "context-engine-skills": {
      "source": {
        "source": "github",
        "repo": "Context-Engine-AI/Context-Engine"
      }
    },
    "punkfl0w-development": {
      "source": {
        "source": "directory",
        "path": "/Users/kuba.gaj/dev/oss/punkfl0w"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "pydantic-claude-code-logfire-plugin": {
      "source": {
        "source": "github",
        "repo": "pydantic/claude-code-logfire-plugin"
      },
      "autoUpdate": true
    },
    "n8n-mcp-skills": {
      "source": {
        "source": "github",
        "repo": "czlonkowski/n8n-skills"
      },
      "autoUpdate": true
    },
    "shopware-ai-coding-tools": {
      "source": {
        "source": "github",
        "repo": "shopwareLabs/ai-coding-tools"
      },
      "autoUpdate": true
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    }
  },
  "otelHeadersHelper": "/Users/kuba.gaj/dotfiles/local/bin/claude-otel-headers",
  "effortLevel": "high",
  "advisorModel": "opus",
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "theme": "dark",
  "editorMode": "vim",
  "autoScrollEnabled": true,
  "teammateMode": "auto",
  "awaySummaryEnable": true,
  "permissionMode": "auto",
  "respectGitIgnore": false
}
