{
  "cleanupPeriodDays": 3,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "60000",
    "BASH_MAX_TIMEOUT_MS": "500000",
    "BASH_MAX_OUTPUT_LENGTH": "1000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "0",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIWONS": "1",
    "CLAUDE_CODE_DISABLE_LEGACY_MODEL_REMAP": "1",
    "CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL": "0",
    "CLAUDE_CODE_FORCE_SYNC_OUTPUT": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_DISABLE_MOUSE": "0",
    "CLAUDE_CODE_SCROLL_SPEED": "3",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "0",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "ENABLE_TOOL_SEARCH": "false",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "MCP_TIMEOUT": "180000",
    "OTEL_TRACES_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "none",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://logfire-eu.pydantic.dev",
    "OTEL_SERVICE_NAME": "claude-code",
    "OTEL_LOG_USER_PROMPTS": "0",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_TOOL_CONTENT": "0"
  },
  "permissions": {
    "allow": [
      "Read",
      "Bash(git *)",
      "Bash(dotter *)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(pwd)",
      "Bash(date *)",
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm list *)",
      "Bash(npx *)",
      "Bash(paru -Qi *)",
      "Bash(paru -Qs *)",
      "Bash(paru -Si *)",
      "Bash(paru -Ss *)",
      "Bash(systemctl status *)",
      "Bash(systemctl is-active *)",
      "Bash(journalctl *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(eza *)",
      "Bash(bat *)",
      "Bash(dust *)",
      "Bash(duf *)",
      "Bash(procs *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(tokei *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(tee *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(uv *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "ToolSearch",
      "mcp__basic-memory*",
      "mcp__firecrawl-lab*",
      "mcp__firecrawl-cloud*",
      "mcp__plugin_context7*"
    ],
    "deny": [
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(npm -g install *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(yarn global *)",
      "Bash(sudo pacman *)",
      "Bash(pacman -S *)",
      "Bash(pacman -R *)",
      "Bash(pacman -U *)",
      "Bash(sudo rm *)",
      "Bash(reboot *)",
      "Bash(shutdown *)",
      "Bash(poweroff *)"
    ],
    "defaultMode": "plan",
    "additionalDirectories": [
      "~/dotfiles",
      "~/Pictures/Screenshots"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/modern-cli.py"
          },
          {
            "type": "command",
            "command": "~/.config/claude/hooks/block-danger.py"
          }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/prefer-tools.py"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/prefer-tools.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write_DISABLED",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/spec-kit-plannotator.py"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks remind --client=claude-code"
          }
        ]
      },
      {
        "matcher": "mcp__serena__*",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks auto-approve --client=claude-code"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks activate --client=claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks cleanup --client=claude-code"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/notify.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"/Users/kuba.gaj/.config/claude/hooks/statusline-combined.sh\""
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "agent-skills@addy-agent-skills": false,
    "skill-codex@skill-codex": true,
    "superpowers@claude-plugins-official": false,
    "punkfl0w@punkfl0w-development": false,
    "caveman@caveman": true,
    "skill-creator@claude-plugins-official": false,
    "logfire-session-capture@pydantic-claude-code-logfire-plugin": false,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      },
      "autoUpdate": true
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "skill-codex": {
      "source": {
        "source": "github",
        "repo": "skills-directory/skill-codex"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "context-engine-skills": {
      "source": {
        "source": "github",
        "repo": "Context-Engine-AI/Context-Engine"
      }
    },
    "punkfl0w-development": {
      "source": {
        "source": "directory",
        "path": "/Users/kuba.gaj/dev/oss/punkfl0w"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "pydantic-claude-code-logfire-plugin": {
      "source": {
        "source": "github",
        "repo": "pydantic/claude-code-logfire-plugin"
      },
      "autoUpdate": true
    },
    "n8n-mcp-skills": {
      "source": {
        "source": "github",
        "repo": "czlonkowski/n8n-skills"
      },
      "autoUpdate": true
    }
  },
  "otelHeadersHelper": "/Users/kuba.gaj/dotfiles/local/bin/claude-otel-headers",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "teammateMode": "auto",
  "skipAutoPermissionPrompt": true,
  "permissionMode": "auto",
  "respectGitIgnore": false
}
