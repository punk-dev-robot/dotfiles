{
  "cleanupPeriodDays": 3,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "60000",
    "BASH_MAX_TIMEOUT_MS": "500000",
    "BASH_MAX_OUTPUT_LENGTH": "1000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "0",
    "DISABLE_TELEMETRY": "1",
    "MCP_TIMEOUT": "180000",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Read",
      "Bash(git *)",
      "Bash(dotter *)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(pwd)",
      "Bash(date *)",
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm list *)",
      "Bash(npx *)",
      "Bash(paru -Qi *)",
      "Bash(paru -Qs *)",
      "Bash(paru -Si *)",
      "Bash(paru -Ss *)",
      "Bash(systemctl status *)",
      "Bash(systemctl is-active *)",
      "Bash(journalctl *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(eza *)",
      "Bash(bat *)",
      "Bash(dust *)",
      "Bash(duf *)",
      "Bash(procs *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(tokei *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(tee *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(uv *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "ToolSearch",
      "mcp__basic-memory*",
      "mcp__firecrawl-lab*",
      "mcp__firecrawl-cloud*",
      "mcp__plugin_context7*"
    ],
    "deny": [
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(npm -g install *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(yarn global *)",
      "Bash(sudo pacman *)",
      "Bash(pacman -S *)",
      "Bash(pacman -R *)",
      "Bash(pacman -U *)",
      "Bash(sudo rm *)",
      "Bash(reboot *)",
      "Bash(shutdown *)",
      "Bash(poweroff *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/dotfiles",
      "~/Pictures/Screenshots"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/modern-cli.py"
          },
          {
            "type": "command",
            "command": "~/.config/claude/hooks/block-danger.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/spec-kit-plannotator.py"
          }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/prefer-tools.py"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/prefer-tools.py"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks remind --client=claude-code"
          }
        ]
      },
      {
        "matcher": "mcp__serena__*",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks auto-approve --client=claude-code"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks activate --client=claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks cleanup --client=claude-code"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/notify.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "agent-skills@addy-agent-skills": false,
    "skill-codex@skill-codex": true,
    "claude-mem@thedotmack": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      },
      "autoUpdate": true
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "skill-codex": {
      "source": {
        "source": "github",
        "repo": "skills-directory/skill-codex"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "context-engine-skills": {
      "source": {
        "source": "github",
        "repo": "Context-Engine-AI/Context-Engine"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "respectGitIgnore": false,
  "teammateMode": "auto",
  "permissionMode": "auto"
}
