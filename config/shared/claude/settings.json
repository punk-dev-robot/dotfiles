{
  "cleanupPeriodDays": 31,
  "skillListingBudgetFraction": 0.02,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "0",
    "CLAUDE_CODE_ALT_SCREEN_FULL_REPAINT": "1",
    "CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL": "0",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_FORCE_SYNC_OUTPUT": "0",
    "CLAUDE_CODE_SCROLL_SPEED": "3",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "0",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "ENABLE_TOOL_SEARCH": "false",
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "MCP_TIMEOUT": "60000",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://ingest.eu2.signoz.cloud:443",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORT_INTERVAL": "5000",
    "OTEL_LOG_TOOL_CONTENT": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000",
    "OTEL_SERVICE_NAME": "claude-code",
    "OTEL_TRACES_EXPORTER": "otlp"
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Read",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(pwd)",
      "Bash(date *)",
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm list *)",
      "Bash(npx *)",
      "Bash(systemctl status *)",
      "Bash(systemctl is-active *)",
      "Bash(journalctl *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(eza *)",
      "Bash(bat *)",
      "Bash(dust *)",
      "Bash(duf *)",
      "Bash(procs *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(tokei *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(tee *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(uv *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "ToolSearch",
      "Bash(curl -sS -X POST https://firestore.googleapis.com/v1/projects/swap-cloud-uat/databases/*)",
      "Bash(curl -sS https://firestore.googleapis.com/v1/projects/swap-cloud-uat/databases/*)",
      "Bash(gcloud firestore databases list --project swap-cloud-uat:*)",
      "Bash(gcloud auth print-access-token:*)"
    ],
    "deny": [
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(npm -g install *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(yarn global *)",
      "Bash(sudo pacman *)",
      "Bash(pacman -S *)",
      "Bash(pacman -R *)",
      "Bash(pacman -U *)",
      "Bash(sudo rm *)",
      "Bash(reboot *)",
      "Bash(shutdown *)",
      "Bash(poweroff *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/dotfiles",
      "~/Pictures/Screenshots"
    ],
    "skipDengerousModePermissionPrompt": true
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/bash-ban-raw-tools.sh"
          },
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/prefer-web-tools.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/hooks/context-mode-cache-heal.mjs"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/kuba.gaj/.config/claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccline"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "claude-notifications-go@claude-notifications-go": true,
    "context-mode@context-mode": true,
    "linear-cli@linear-cli": true,
    "logfire-session-capture@pydantic-claude-code-logfire-plugin": false,
    "plannotator@plannotator": true,
    "security-guidance@claude-plugins-official": true,
    "claude-obsidian@agricidaniel-claude-obsidian": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      },
      "autoUpdate": true
    },
    "claude-notifications-go": {
      "source": {
        "source": "github",
        "repo": "777genius/claude-notifications-go"
      },
      "autoUpdate": true
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      },
      "autoUpdate": true
    },
    "linear-cli": {
      "source": {
        "source": "github",
        "repo": "schpet/linear-cli"
      },
      "autoUpdate": true
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      },
      "autoUpdate": true
    },
    "pydantic-claude-code-logfire-plugin": {
      "source": {
        "source": "github",
        "repo": "pydantic/claude-code-logfire-plugin"
      },
      "autoUpdate": true
    },
    "agricidaniel-claude-obsidian": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-obsidian"
      }
    }
  },
  "otelHeadersHelper": "/Users/kuba.gaj/dotfiles/local/bin/claude-otel-headers",
  "effortLevel": "high",
  "advisorModel": "opus",
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "theme": "dark",
  "editorMode": "vim",
  "autoScrollEnabled": true,
  "teammateMode": "auto",
  "awaySummaryEnable": true,
  "permissionMode": "auto",
  "respectGitIgnore": false
}
