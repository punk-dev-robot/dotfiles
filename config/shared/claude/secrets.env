# Claude Code MCP server secrets (resolved by op run at runtime)
# Secrets stored in 1Password "AI" vault (desktop app auth)

# GitHub plugin
GITHUB_PERSONAL_ACCESS_TOKEN=op://AI/GitHub-MCP/password

# GitLab plugin
GITLAB_PERSONAL_ACCESS_TOKEN=op://AI/GitLab-MCP/password

# Exa plugin
EXA_API_KEY=op://AI/Exa-MCP/password

# Context7
CONTEXT7_API_KEY=op://AI/Context7-MCP/password

# Firecrawl cloud API (backup when self-hosted fails)
FIRECRAWL_API_KEY=op://AI/Firecrawl-MCP/password

# Hugging Face
HF_TOKEN=op://AI/HF_CLI_TOKEN/password

# OpenAI API key via LiteLLM proxy (used by OpenCode's taskmaster-ai)
# OPENAI_API_KEY=op://AI/OcOpenAiApiKey/password

ELEVENLABS_API_KEY=op://AI/ElevenLabs-MCP/password

SUPERMEMORY_CC_API_KEY=op://AI/SUPERMEMORY_CC_API_KEY/password

# Swap
N8N_API_KEY=op://AI/Swap-N8N-MCP/password
# using mcp for now
# LOGFIRE_TOKEN=op://AI/Swap-Logfire-Read-Token/ingestion
SIGNOZ_TOKEN=op://AI/SigNozApiKey/password2
# WEBHOOK_SECURITY_MODE=moderate      # Required when N8N_API_URL is localhost or RFC1918
# MCP_AUTH_TOKEN=test-token-minimum-32-chars-long
# AUTH_TOKEN=test-token-minimum-32-chars-long  # Same value as MCP_AUTH_TOKEN
# PORT=3001

VOYAGE_API_KEY=op://AI/Swap-Voyage-Default-Token/password
LINEAR_API_KEY=op://AI/Swap-LinearApiKey/password

# Slack MCP pre-registered client (gateway mcp-remote bridge)
SLACK_MCP_CLIENT_SECRET=op://AI/Swap-Slack-MCP-Client-Secret/password
