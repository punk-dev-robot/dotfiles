{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/context-mode.md"],
  "mcp": {
    "logfire": {
      "enabled": false,
      "type": "remote",
      "url": "https://logfire-eu.pydantic.dev/mcp",
    },
    "tessl": {
      "enabled": true,
      "type": "local",
      "command": ["tessl", "mcp", "start"],
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/kuba.gaj/dotfiles",
        "/Users/kuba.gaj/dev",
        "/Users/kuba.gaj/Documents/notes",
      ],
    },
  },
  "plugin": ["context-mode", "@plannotator/opencode@latest"],
  "skills": {
    "paths": ["/Users/kuba.gaj/.config/opencode/skills"],
  },
  "permission": {
    "bash": {
      "nx run deploy:*": "deny",
      "nx deploy:*": "deny",
    },
  },
}
