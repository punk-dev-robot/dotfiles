[Desktop Entry]
# KUB-118: shadows /usr/share/applications/Linear.desktop. Native Wayland: tao 0.34 draws its own header bar
# (GTK_CSD=0 / Hyprland rules can't remove it) — accepted over XWayland (blurry + black artifacts on hover popovers).
# GTK_THEME kept so WebKit renders dark. Re-check header bar once linear-desktop-bin ships Tauri >= 2.12 (tao >= 0.36).
Categories=
Exec=env GDK_BACKEND=wayland GTK_THEME=Adwaita:dark linear-linux %U
StartupWMClass=linear-linux
Icon=linear-linux
Name=Linear
Terminal=false
Type=Application
