#!/bin/bash

AEROSPACE=/opt/homebrew/bin/aerospace
TILED_LAYOUT_REGEX='^(h|v)_(tiles|accordion)$|^(tiles|accordion)$'
TARGET_WEIGHT=1000

focused_id=$("$AEROSPACE" list-windows --focused --format '%{window-id}' 2>/dev/null)

"$AEROSPACE" flatten-workspace-tree >/dev/null 2>&1 || exit 1
"$AEROSPACE" layout h_tiles >/dev/null 2>&1 || exit 1

while IFS= read -r line; do
  window_id=${line%% *}
  window_layout=${line#* }

  if printf '%s\n' "$window_layout" | grep -Eq "$TILED_LAYOUT_REGEX"; then
    "$AEROSPACE" focus --window-id "$window_id" >/dev/null 2>&1 || continue
    "$AEROSPACE" resize width "$TARGET_WEIGHT" >/dev/null 2>&1 || true
  fi
done < <("$AEROSPACE" list-windows --workspace focused --format '%{window-id} %{window-layout}' 2>/dev/null)

"$AEROSPACE" balance-sizes >/dev/null 2>&1 || true
[ -n "$focused_id" ] && "$AEROSPACE" focus --window-id "$focused_id" >/dev/null 2>&1 || true
