#!/bin/sh
# Prefix Matt Pocock tessl skills with 'cock-' so their names stop colliding
# with generic trigger words. Idempotent. Re-run after `tessl update` —
# updates overwrite SKILL.md and revert the names.
set -eu

root="$HOME/.tessl/plugins/mattpocock/skills/skills"

for f in "$root"/*/*/SKILL.md; do
  sed -i '' 's/^name: \(cock-\)\{0,1\}/name: cock-/' "$f"
done

# Skills cross-reference each other slash-style (/grilling, /tdd, ...) in SKILL.md
# bodies and scripts — rewrite those to the prefixed names too. Idempotent:
# /cock-grilling contains no /grilling substring, so a second run is a no-op.
names=$(sed -n 's/^name: cock-//p' "$root"/*/*/SKILL.md)
for n in $names; do
  find "$root" -type f | while read -r f; do
    perl -pi -e "s{/\\Q$n\\E\\b}{/cock-$n}g" "$f"
  done
done

grep -h '^name:' "$root"/*/*/SKILL.md
