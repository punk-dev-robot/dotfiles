#!/opt/homebrew/bin/bash
# Toggle a scratchpad window: summon to current workspace or move to scratchpad.
# Usage: aerospace-toggle <app-name> [launch-command]
# If launch-command is omitted, defaults to: open -a <app-name>

APP="$1"
LAUNCH="${2:-open -a \"$APP\"}"

if [ -z "$APP" ]; then
  echo "Usage: aerospace-toggle <app-name> [launch-command]" >&2
  exit 1
fi

SCRATCHPAD=/opt/homebrew/bin/aerospace-scratchpad
FRAME_HELPER="$HOME/.local/bin/aerospace-scratchpad-frame"
SCRATCHPAD_APPS=(
  "Rio"
  "Slack"
  "WhatsApp"
  "Claude"
  "Todoist"
  "Linear"
  "Spotify"
  "Notion"
  "Obsidian"
  "1Password"
)

normalize_name() {
  local s="${1//[^[:alnum:]]/}"
  printf '%s' "${s,,}"
}

declare -A MANAGED_SET=()
for _app in "${SCRATCHPAD_APPS[@]}"; do
  MANAGED_SET[$(normalize_name "$_app")]=1
done
unset _app

is_managed_scratchpad_app() {
  [[ -n "${MANAGED_SET[$(normalize_name "$1")]:-}" ]]
}

center_scratchpad() {
  [ -x "$FRAME_HELPER" ] || return 0
  local target_monitor
  target_monitor=$(/opt/homebrew/bin/aerospace list-monitors --focused --format '%{monitor-name}' 2>/dev/null)
  "$FRAME_HELPER" "$APP" "$target_monitor" >/dev/null 2>&1 &
}

hide_other_floating_scratchpads() {
  local target_app normalized_target workspace window_id app_name window_layout

  target_app="$1"
  normalized_target=$(normalize_name "$target_app")

  while IFS=$'\t' read -r workspace window_id app_name window_layout; do
    [ -z "$app_name" ] && continue
    [ "$window_layout" != "floating" ] && continue
    [[ "$workspace" == .scratchpad* ]] && continue

    if ! is_managed_scratchpad_app "$app_name"; then
      continue
    fi

    if [ "$(normalize_name "$app_name")" = "$normalized_target" ]; then
      continue
    fi

    "$SCRATCHPAD" move "$app_name" >/dev/null 2>&1 || true
  done < <(/opt/homebrew/bin/aerospace list-windows --all --format '%{workspace}	%{window-id}	%{app-name}	%{window-layout}' 2>/dev/null)
}

result=$($SCRATCHPAD summon --output json "$APP" 2>&1)
action=""
[[ "$result" =~ \"result\":\"([a-z_]+)\" ]] && action="${BASH_REMATCH[1]}"

case "$action" in
  ok)
    # Window summoned — cleanup other visible scratchpads + frame in background
    { hide_other_floating_scratchpads "$APP"; center_scratchpad; } &
    ;;
  skipped)
    # Already on current workspace — move to scratchpad (must block: user wants it gone)
    $SCRATCHPAD move "$APP"
    ;;
  *)
    # Not found — launch the app, then async cleanup + frame
    eval "$LAUNCH"
    { hide_other_floating_scratchpads "$APP"; center_scratchpad; } &
    ;;
esac
disown -a 2>/dev/null || true
