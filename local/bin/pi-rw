#!/usr/bin/env bash
# pi-rw — run pi against the KUB-17-repowise worktree config.
#
# Mirrors ~/.config/pi/agent into ~/.config/pi-repowise:
#   - dotter-managed symlinks (-> ~/dotfiles/...) are re-pointed at the worktree
#   - everything else (auth, npm, sessions, caches, state) is shared via symlink
# Then execs pi with PI_CODING_AGENT_DIR set. Default `pi` stays untouched.
set -euo pipefail

SRC="$HOME/.config/pi/agent"
DST="$HOME/.config/pi-repowise"
MAIN="$HOME/dotfiles"
WT="$HOME/dotfiles.KUB-17-repowise"

mirror() {
  local s=$1 d=$2 f name tgt
  mkdir -p "$d"
  for f in "$s"/* "$s"/.[!.]*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    name=${f##*/}
    if [ -L "$f" ]; then
      tgt=$(readlink "$f")
      case "$tgt" in
        "$MAIN"/*) ln -sfn "$WT${tgt#"$MAIN"}" "$d/$name" ;;
        *)         ln -sfn "$f" "$d/$name" ;;
      esac
    elif [ -d "$f" ] && find "$f" -maxdepth 4 -type l -lname "$MAIN/*" 2>/dev/null | grep -q .; then
      mirror "$f" "$d/$name"   # dir contains dotter links: replicate tree
    else
      ln -sfn "$f" "$d/$name"  # plain state: share with the real instance
    fi
  done
}

rm -rf "$DST"   # fully regenerated each launch; only symlinks live here
mirror "$SRC" "$DST"

# Overlay: files that exist only in the worktree config (not yet in the live,
# main-checkout-deployed dir) still belong in the sandbox.
while IFS= read -r -d '' f; do
  rel=${f#"$WT/config/custom/pi/agent/"}
  [ -e "$DST/$rel" ] || [ -L "$DST/$rel" ] || { mkdir -p "$DST/$(dirname "$rel")"; ln -s "$f" "$DST/$rel"; }
done < <(find "$WT/config/custom/pi/agent" -type f -print0)

# /tools global+model scopes live outside the agent dir; point them at the worktree copy
export PI_WEBUI_SETTINGS_FILE="$WT/config/custom/pi/webui/settings.json"
PI_CODING_AGENT_DIR="$DST" exec pi "$@"
